# Copy this file to .env for local development and fill in a real connection
# string. Never commit the real .env — it's already gitignored.

# A PostgreSQL connection string. Point this at a throwaway local/dev
# database, not your production one. See ../DEPLOYMENT.md for how to get one
# for free (Neon, Supabase, etc. all work).
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Port the server listens on. Hosting platforms usually inject this
# themselves — leave it unset in production and let the platform decide.
PORT=8080

# Origin allowed to call this API from a browser. Set this to your deployed
# frontend's URL in production.
ALLOW_ORIGIN=http://localhost:5173
